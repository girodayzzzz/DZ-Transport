# Astro build variables. Disabled until the corresponding owner checks pass.
DZ_SITE_MODE=preview
SITE_URL=https://localhost
BASE_PATH=/
PUBLIC_DZ_PORTAL=false
PUBLIC_DZ_CUSTOMER_ONBOARDING=false
PUBLIC_DZ_MANAGER=false
PUBLIC_DZ_PARTNER=false
PUBLIC_DZ_QUICK_DEAL=false
PUBLIC_DZ_GOOGLE=false
PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PUBLIC_DZ_GUEST_INTAKE=false
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Pages Function bindings. Enter real values only as protected secrets.
DZ_GUEST_INTAKE=false
DZ_SITE_ORIGIN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET=
DZ_IP_HASH_KEY=

# DZ Transport V8. Enable only on an isolated test deployment and database.
DZ_STRIPE_TEST=false
SUPABASE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
DZ_STRIPE_JOB_TOKEN=
